{
  "info": {
    "name": "GoldGraft API & Lifecycle Verification Suite",
    "_postman_id": "c1f7b882-901e-450a-9d91-goldgraft001",
    "description": "Published offline reference profile: API metadata/custody smoke checks followed by the existing seeded fixture shop \u2192 runner \u2192 actual proof \u2192 durable ledger. Synthetic credentials only; no external provider verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Probe Shop Integration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://github.com/goldgraft/legacy-php-shop\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/probe",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "probe"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Discovered legacy families', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.families_found).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02 - Create Shop Metadata (Independent Smoke Check)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"repo\": \"https://github.com/goldgraft/legacy-php-shop\",\n  \"name\": \"Cutover Legacy PHP Shop\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/shops",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "shops"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Shop created successfully', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.environment.set('createdShopId', json.shop_id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03 - Synthetic Custody Isolation (Seeded Fixture Shop)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"paypal_client_id\": \"fixture-only-client\", \"paypal_client_secret\": \"fixture-only-secret\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/shops/{{shopId}}/connect",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "shops",
            "{{shopId}}",
            "connect"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Synthetic in-memory credential custody returns an opaque reference', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.expect(json.secrets_ref).to.match(/^doppler:\\/\\//);",
              "pm.expect(pm.response.text()).to.not.include('fixture-only-secret');"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "04 - Run Published Fixture Proof Through Backend",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "pushed-reference-v1"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/shops/{{shopId}}/graft",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "shops",
            "{{shopId}}",
            "graft"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Graft started successfully', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.environment.set('graftId', json.graft_id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "05 - Verify Proof & Strength",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/grafts/{{graftId}}/proof",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "grafts",
            "{{graftId}}",
            "proof"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Computed fixture proof returned', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.expect(json.proof_strength.total).to.eql(12);",
              "pm.expect(json.proof_strength.score).to.be.within(0, 1);",
              "pm.expect(json.triangle).to.be.an('array');"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
