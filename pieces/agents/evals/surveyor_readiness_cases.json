{
  "format": "SurveyorSourceReadinessDiagnostic/1",
  "rights": "Original synthetic project MIT snippets; no merchant source.",
  "baseline_case_ids": ["inventory-nvp", "inventory-browser-ipn", "inventory-layout-injection", "inventory-no-known-indicators"],
  "cases": [
    {
      "id": "readiness-comment-reference",
      "shop_id": "readiness-comment",
      "files": {"checkout.php": "<?php\n// require \"not-a-dependency.php\";\n$method = 'RefundTransaction';\n"},
      "expected_outcome": "completed",
      "expected": [{"family": "EC_NVP", "operation": "RefundTransaction", "file": "checkout.php", "line": 3, "flow": "refund", "mapping_id": "nvp-refund"}]
    },
    {
      "id": "readiness-quoted-reference",
      "shop_id": "readiness-quoted",
      "files": {"checkout.php": "<?php\n$note = 'include \"not-a-dependency.php\";';\n$method = 'SetExpressCheckout';\n"},
      "expected_outcome": "completed",
      "expected": [{"family": "EC_NVP", "operation": "SetExpressCheckout", "file": "checkout.php", "line": 3, "flow": "create", "mapping_id": "nvp-create"}]
    },
    {
      "id": "readiness-uppercase-reference",
      "shop_id": "readiness-uppercase",
      "files": {"checkout.php": "<?php\nREQUIRE_ONCE 'pay.php';\n", "pay.php": "<?php\n$method = 'RefundTransaction';\n"},
      "expected_outcome": "completed",
      "expected": [{"family": "EC_NVP", "operation": "RefundTransaction", "file": "pay.php", "line": 2, "flow": "refund", "mapping_id": "nvp-refund"}]
    },
    {
      "id": "readiness-multiline-reference",
      "shop_id": "readiness-multiline",
      "files": {"checkout.php": "<?php\nrequire\n/* dependency */\n('pay.php');\n", "pay.php": "<?php\n$method = 'SetExpressCheckout';\n"},
      "expected_outcome": "completed",
      "expected": [{"family": "EC_NVP", "operation": "SetExpressCheckout", "file": "pay.php", "line": 2, "flow": "create", "mapping_id": "nvp-create"}]
    },
    {
      "id": "readiness-dir-parent-reference",
      "shop_id": "readiness-dir-parent",
      "files": {"pages/checkout.php": "<?php\nrequire __DIR__ . '/../lib/pay.php';\n", "lib/pay.php": "<?php\n$method = 'RefundTransaction';\n"},
      "expected_outcome": "completed",
      "expected": [{"family": "EC_NVP", "operation": "RefundTransaction", "file": "lib/pay.php", "line": 2, "flow": "refund", "mapping_id": "nvp-refund"}]
    },
    {
