  "origin_rules": [
    "Old transaction refunds remain NVP RefundTransaction; REST refunds apply only to new captures. No cross-generation refund equivalence is claimed.",
    "Keep the IPN listener for old objects; keep in-flight sessions on their birth rail."
  ],
  "order": [
    "READ_BOTH",
    "NEW_FLOWS_BEHIND_SWITCH",
    "CLEANUP"
  ],
  "handoff": [],
  "deltas": [
    {
      "id": "D_TOKEN_ORDER",
      "mapping_id": "https://developer.paypal.com/api/orders/v2/",
      "description": "Map pp.legacy_token to pp.order_id for the same logical order; preserve order_ref and money. Different run IDs are noise, not a new order."
    },
    {
      "id": "D_TXN_CAPTURE",
      "mapping_id": "https://developer.paypal.com/api/orders/v2/",
      "description": "Map NVP PAYMENTINFO_0_TRANSACTIONID / ledger TRANSACTIONID to REST capture_id, preserving distinct captures, amount, currency and status."
    },
    {
      "id": "D_APPROVE",
      "mapping_id": "https://developer.paypal.com/sdk/js/reference/",
      "description": "Map checkout.js onAuthorize/approved token+PayerID return to v6 onApprove orderId. Preserve APPROVE and its causal position."
    },
    {
      "id": "D_NOTIFY",
      "mapping_id": "https://developer.paypal.com/api/webhooks/v1/",
      "description": "IPN Completed becomes webhook PAYMENT.CAPTURE.COMPLETED. VERIFIED/INVALID becomes verification_status SUCCESS/FAILURE. Preserve NOTIFY and verification result, amounts and causal order."
    },
    {
      "id": "D_LEDGER_READ",
      "mapping_id": "https://developer.paypal.com/api/orders/v2/",
      "description": "One NVP GetTransactionDetails capture lookup becomes GET order plus GET capture. Coalesce repeated ledger observations with the same economic ID, status and money; preserve different IDs and state revisions. Renumber observation seq after this read fan-out."
    },
    {
      "id": "D_REFUND",
      "mapping_id": "https://developer.paypal.com/api/payments/v2/",
      "description": "Map successful NVP RefundTransaction instant refund and GetTransactionDetails refund ledger to REST refund COMPLETED / GET refund. IDs differ, REFUND amount and REFUNDED status do not."
    }
  ]
}
