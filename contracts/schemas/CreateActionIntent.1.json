{
  "$id": "https://goldgraft.dev/schemas/CreateActionIntent.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "readiness_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Readiness Digest",
      "type": "string"
    },
    "readiness_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Readiness Id",
      "type": "string"
    }
  },
  "required": [
    "readiness_id",
    "readiness_digest"
  ],
  "title": "CreateActionIntentV1",
  "type": "object"
}
