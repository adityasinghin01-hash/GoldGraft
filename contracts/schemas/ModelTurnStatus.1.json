{
  "$defs": {
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Evidence Refs",
          "type": "array"
        },
        "input_ref": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Ref"
        },
        "owner_role": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Owner Role",
          "type": "string"
        },
        "recovery": {
          "enum": [
            "retry_read",
            "reconnect",
            "supply_input",
            "review_scope",
            "reapprove",
            "await_counterpart",
            "reconcile",
            "unsupported"
          ],
          "title": "Recovery",
          "type": "string"
        }
      },
      "required": [
        "code",
        "input_ref",
        "owner_role",
        "recovery",
        "evidence_refs"
      ],
      "title": "Issue",
      "type": "object"
    }
  },
  "$id": "https://goldgraft.dev/schemas/ModelTurnStatus.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "issue": {
      "anyOf": [
        {
          "$ref": "#/$defs/Issue"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Result Ref"
    },
    "state": {
      "enum": [
        "intended",
        "submitted",
        "observed",
        "failed",
        "unknown"
      ],
      "title": "State",
      "type": "string"
    },
    "task_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Task Id",
      "type": "string"
    },
    "turn_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Turn Id",
      "type": "string"
    },
    "usage_receipt_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Usage Receipt Ref"
    }
  },
  "required": [
    "turn_id",
    "task_id",
    "state",
    "result_ref",
    "usage_receipt_ref",
    "checked_at",
    "issue"
  ],
  "title": "ModelTurnStatusV1",
  "type": "object"
}
