{
  "$defs": {
    "CapabilityDenial": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "enum": [
            "source_read",
            "model_execution",
            "host_mutation",
            "worker_dispatch"
          ],
          "title": "Capability",
          "type": "string"
        },
        "denied_at": {
          "format": "date-time",
          "title": "Denied At",
          "type": "string"
        },
        "evidence_ref": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "capability",
        "evidence_ref",
        "payload_digest",
        "denied_at"
      ],
      "title": "CapabilityDenial",
      "type": "object"
    },
    "ExitCriterionObservation": {
      "additionalProperties": false,
      "properties": {
        "criterion_ref": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Criterion Ref",
          "type": "string"
        },
        "evidence_ref": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Digest",
          "type": "string"
        },
        "state": {
          "enum": [
            "verified",
            "failed",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "criterion_ref",
        "state",
        "evidence_ref",
        "payload_digest",
        "observed_at"
      ],
      "title": "ExitCriterionObservation",
      "type": "object"
    },
    "SignatureMaterial": {
      "additionalProperties": false,
      "properties": {
        "authenticity_ref": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Authenticity Ref",
          "type": "string"
        },
        "signature_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Signature Digest",
          "type": "string"
        },
        "signature_ref": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Signature Ref",
          "type": "string"
        },
        "transparency_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Transparency Digest",
          "type": "string"
        },
        "transparency_ref": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Transparency Ref",
          "type": "string"
        }
      },
      "required": [
        "signature_ref",
        "signature_digest",
        "transparency_ref",
        "transparency_digest",
        "authenticity_ref"
      ],
      "title": "SignatureMaterial",
      "type": "object"
    }
  },
  "$id": "https://goldgraft.dev/schemas/ExitCheckResult.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Case Id",
      "type": "string"
    },
    "evidence_read_authority_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Evidence Read Authority Ref",
      "type": "string"
    },
    "executor_identity_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Executor Identity Ref",
      "type": "string"
    },
    "exit_plan_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Exit Plan Digest",
      "type": "string"
    },
    "exit_plan_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Exit Plan Ref",
      "type": "string"
    },
    "final_artifact_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Final Artifact Digest",
      "type": "string"
    },
    "final_config_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Final Config Digest",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "generation": {
      "exclusiveMinimum": 0,
      "title": "Generation",
      "type": "integer"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/ExitCriterionObservation"
      },
      "maxItems": 256,
      "title": "Observations",
      "type": "array"
    },
    "ordinary_denials": {
      "items": {
        "$ref": "#/$defs/CapabilityDenial"
      },
      "maxItems": 256,
      "title": "Ordinary Denials",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "verified",
        "held",
        "failed",
        "unknown"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "reservation_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Reservation Ref",
      "type": "string"
    },
    "resource_epochs": {
      "maxProperties": 256,
      "patternProperties": {
        "^\\S+$": {
          "exclusiveMinimum": 0,
          "type": "integer"
        }
      },
      "propertyNames": {
        "maxLength": 256,
        "minLength": 1
      },
      "title": "Resource Epochs",
      "type": "object"
    },
    "restart_count": {
      "maximum": 1,
      "minimum": 0,
      "title": "Restart Count",
      "type": "integer"
    },
    "result_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Result Digest",
      "type": "string"
    },
    "result_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Result Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Run Id",
      "type": "string"
    },
    "scope_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scope Digest",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/SignatureMaterial"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "state_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "State Digest",
      "type": "string"
    },
    "trusted_code_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Trusted Code Digest",
      "type": "string"
    },
    "work_package_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Work Package Digest",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "run_id",
    "generation",
    "resource_epochs",
    "scope_digest",
    "work_package_digest",
    "policy_digest",
    "result_id",
    "exit_plan_ref",
    "exit_plan_digest",
    "reservation_ref",
    "executor_identity_ref",
    "trusted_code_digest",
    "final_artifact_digest",
    "final_config_digest",
    "state_digest",
    "restart_count",
    "ordinary_denials",
    "observations",
    "evidence_read_authority_ref",
    "outcome",
    "started_at",
    "finished_at",
    "result_digest",
    "signature"
  ],
  "title": "ExitCheckResultV1",
  "type": "object"
}
