    "acceptance_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Acceptance Ref"
    },
    "status": {
      "$ref": "#/$defs/WorkStatus"
    }
  },
  "required": [
