{
  "$id": "https://goldgraft.dev/schemas/PendingResult.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Evidence Refs",
      "type": "array"
    },
    "request_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Request Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "waiting",
        "unknown"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "state",
    "evidence_refs",
    "checked_at"
  ],
  "title": "PendingResultV1",
  "type": "object"
}
