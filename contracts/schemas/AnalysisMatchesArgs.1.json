{
  "$id": "https://goldgraft.dev/schemas/AnalysisMatchesArgs.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "max_matches": {
      "exclusiveMinimum": 0,
      "maximum": 500,
      "title": "Max Matches",
      "type": "integer"
    },
    "rule_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Rule Ref",
      "type": "string"
    },
    "snapshot_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Snapshot Ref",
      "type": "string"
    }
  },
  "required": [
    "snapshot_ref",
    "rule_ref",
    "max_matches"
  ],
  "title": "AnalysisMatchesArgsV1",
  "type": "object"
}
