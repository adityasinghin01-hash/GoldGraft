{
  "$id": "https://goldgraft.dev/schemas/ApprovalSet.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_refs": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Approval Refs",
      "type": "array"
    },
    "approval_set_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Approval Set Id",
      "type": "string"
    },
    "authority_epochs": {
      "maxProperties": 256,
      "patternProperties": {
        "^\\S+$": {
          "exclusiveMinimum": 0,
          "type": "integer"
        }
      },
      "propertyNames": {
        "maxLength": 256,
        "minLength": 1
      },
      "title": "Authority Epochs",
      "type": "object"
    },
    "case_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Case Id",
      "type": "string"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "generation": {
      "exclusiveMinimum": 0,
      "title": "Generation",
      "type": "integer"
    },
    "plan_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "required_controller_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Required Controller Ids",
      "type": "array"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Run Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "complete",
        "missing",
        "stale",
        "revoked"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "approval_set_id",
    "case_id",
    "run_id",
    "generation",
    "plan_digest",
    "required_controller_ids",
    "approval_refs",
    "authority_epochs",
    "checked_at",
    "state"
  ],
  "title": "ApprovalSetV1",
  "type": "object"
}
