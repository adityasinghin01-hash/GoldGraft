{
  "$id": "https://goldgraft.dev/schemas/LifecycleWorkRequestReceipt.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_at": {
      "format": "date-time",
      "title": "Accepted At",
      "type": "string"
    },
    "generation": {
      "exclusiveMinimum": 0,
      "title": "Generation",
      "type": "integer"
    },
    "request_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "request_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "generation",
    "accepted_at",
    "request_digest"
  ],
  "title": "LifecycleWorkRequestReceiptV1",
  "type": "object"
}
