{
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProducerKind"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "Producer",
      "type": "object"
    },
    "ProducerKind": {
      "enum": [
        "agent",
        "service"
      ],
      "title": "ProducerKind",
      "type": "string"
    }
  },
  "$id": "https://goldgraft.dev/schemas/DashboardSpec.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "minimal v1, owner Aditya may extend",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "filters": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Filters",
      "type": "object"
    },
    "graft_id": {
      "minLength": 1,
      "title": "Graft Id",
      "type": "string"
    },
    "group_by": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Group By",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "metrics": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Metrics",
      "type": "array"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "graft_id",
    "producer",
    "created_at",
    "question",
    "title",
    "metrics",
    "group_by",
    "filters",
    "evidence_refs"
  ],
  "title": "DashboardSpecV1",
  "type": "object"
}
