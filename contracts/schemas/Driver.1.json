          "title": "Api Step",
          "type": "string"
        }
      },
      "required": [
        "api_step"
      ],
      "title": "ApiStep",
      "type": "object"
    },
    "DriverStep": {
      "additionalProperties": false,
      "properties": {
        "driver_step": {
          "minLength": 1,
          "title": "Driver Step",
          "type": "string"
        }
      },
      "required": [
        "driver_step"
      ],
      "title": "DriverStep",
      "type": "object"
    },
    "MockStep": {
      "additionalProperties": false,
      "properties": {
        "paypal_mock_response_code": {
          "minLength": 1,
          "title": "Paypal Mock Response Code",
          "type": "string"
        }
      },
      "required": [
        "paypal_mock_response_code"
      ],
      "title": "MockStep",
      "type": "object"
    }
