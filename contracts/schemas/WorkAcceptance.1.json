{
  "$id": "https://goldgraft.dev/schemas/WorkAcceptance.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_at": {
      "format": "date-time",
      "title": "Accepted At",
      "type": "string"
    },
    "action_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Action Id",
      "type": "string"
    },
    "case_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Case Id",
      "type": "string"
    },
    "readiness_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Readiness Digest",
      "type": "string"
    },
    "receipt_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Receipt Ref",
      "type": "string"
    },
    "resource_graph_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Resource Graph Digest",
      "type": "string"
    },
    "scope_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scope Digest",
      "type": "string"
    },
    "source_manifest_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Manifest Digest",
      "type": "string"
    },
    "work_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Work Id",
      "type": "string"
    },
    "work_package_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Work Package Digest",
      "type": "string"
    }
  },
  "required": [
    "action_id",
    "case_id",
    "work_id",
    "accepted_at",
    "readiness_digest",
    "work_package_digest",
    "resource_graph_digest",
    "scope_digest",
    "source_manifest_digest",
    "receipt_ref"
  ],
  "title": "WorkAcceptanceV1",
  "type": "object"
}
