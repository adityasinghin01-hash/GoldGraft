{
  "$defs": {
    "HeraldKind": {
      "enum": [
        "GRAFT_CARD",
        "PR_BODY",
        "HANDOFF",
        "VERDICT_EXPLAIN"
      ],
      "title": "HeraldKind",
      "type": "string"
    },
    "LedgerNumber": {
      "additionalProperties": false,
      "properties": {
        "entry_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Entry Hash",
          "type": "string"
        },
        "json_pointer": {
          "pattern": "^/",
          "title": "Json Pointer",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "entry_hash",
        "json_pointer",
        "value"
      ],
      "title": "LedgerNumber",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProducerKind"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "Producer",
      "type": "object"
    },
    "ProducerKind": {
      "enum": [
        "agent",
        "service"
      ],
      "title": "ProducerKind",
      "type": "string"
    }
  },
  "$id": "https://goldgraft.dev/schemas/HeraldText.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "minimal v1, owner Aditya may extend",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "graft_id": {
      "minLength": 1,
      "title": "Graft Id",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/HeraldKind"
    },
    "numbers_used": {
      "items": {
        "$ref": "#/$defs/LedgerNumber"
      },
      "title": "Numbers Used",
      "type": "array"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "id",
    "graft_id",
    "producer",
    "created_at",
    "kind",
    "text",
    "numbers_used"
  ],
  "title": "HeraldTextV1",
  "type": "object"
}
