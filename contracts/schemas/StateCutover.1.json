{
  "$id": "https://goldgraft.dev/schemas/StateCutover.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Admission Ref",
      "type": "string"
    },
    "case_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Case Id",
      "type": "string"
    },
    "cutover_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Cutover Id",
      "type": "string"
    },
    "drain_evidence_refs": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Drain Evidence Refs",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Evidence Refs",
      "type": "array"
    },
    "export_manifest_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Export Manifest Ref",
      "type": "string"
    },
    "fence_epochs": {
      "maxProperties": 256,
      "patternProperties": {
        "^\\S+$": {
          "exclusiveMinimum": 0,
          "type": "integer"
        }
      },
      "propertyNames": {
        "maxLength": 256,
        "minLength": 1
      },
      "title": "Fence Epochs",
      "type": "object"
    },
    "generation": {
      "exclusiveMinimum": 0,
      "title": "Generation",
      "type": "integer"
    },
    "handler_inventory_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Handler Inventory Ref",
      "type": "string"
    },
    "high_water_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "High Water Ref",
      "type": "string"
    },
    "ingress_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Ingress Ref",
      "type": "string"
    },
    "origin_route_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Origin Route Ref",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "prepared",
        "fenced",
        "exported",
        "restored",
        "replayed",
        "verified",
        "held",
        "unknown"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "pending_external_effect_refs": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Pending External Effect Refs",
      "type": "array"
    },
    "replay_manifest_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Replay Manifest Ref",
      "type": "string"
    },
    "restore_manifest_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Restore Manifest Ref",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Schema Digest",
      "type": "string"
    },
    "state_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "State Digest",
      "type": "string"
    },
    "writer_inventory_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Writer Inventory Ref",
      "type": "string"
    }
  },
  "required": [
    "cutover_id",
    "case_id",
    "run_id",
    "generation",
    "writer_inventory_ref",
    "handler_inventory_ref",
    "ingress_ref",
    "origin_route_ref",
    "admission_ref",
    "drain_evidence_refs",
    "fence_epochs",
    "high_water_ref",
    "export_manifest_ref",
    "restore_manifest_ref",
    "replay_manifest_ref",
    "state_digest",
    "schema_digest",
    "pending_external_effect_refs",
    "evidence_refs",
    "outcome"
  ],
  "title": "StateCutoverV1",
  "type": "object"
}
