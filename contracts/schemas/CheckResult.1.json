{
  "$id": "https://goldgraft.dev/schemas/CheckResult.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "check_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Check Id",
      "type": "string"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Evidence Refs",
      "type": "array"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expires At"
    },
    "recovery_code": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Recovery Code"
    },
    "status": {
      "enum": [
        "pass",
        "missing",
        "unsupported",
        "failed",
        "stale",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "check_id",
    "status",
    "evidence_refs",
    "checked_at",
    "expires_at",
    "recovery_code"
  ],
  "title": "CheckResultV1",
  "type": "object"
}
