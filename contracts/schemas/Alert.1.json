{
  "$defs": {
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProducerKind"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "Producer",
      "type": "object"
    },
    "ProducerKind": {
      "enum": [
        "agent",
        "service"
      ],
      "title": "ProducerKind",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "CRITICAL",
        "MAJOR",
        "MINOR"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "https://goldgraft.dev/schemas/Alert.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "minimal v1, owner Aditya may extend",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "graft_id": {
      "minLength": 1,
      "title": "Graft Id",
      "type": "string"
    },
    "halted_agent": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Halted Agent"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    }
  },
  "required": [
    "id",
    "graft_id",
    "producer",
    "created_at",
    "severity",
    "message",
    "evidence_refs"
  ],
  "title": "AlertV1",
  "type": "object"
}
