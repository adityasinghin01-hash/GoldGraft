{
  "$id": "https://goldgraft.dev/schemas/RequiredAction.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "kind": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Kind",
      "type": "string"
    },
    "reason_code": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason Code"
    },
    "resource_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Resource Ids",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "resource_ids",
    "enabled",
    "reason_code"
  ],
  "title": "RequiredActionV1",
  "type": "object"
}
