{
  "$id": "https://goldgraft.dev/schemas/ActionIntent.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Action Id",
      "type": "string"
    },
    "actor_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Actor Id",
      "type": "string"
    },
    "case_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Case Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "readiness_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Readiness Digest",
      "type": "string"
    },
    "readiness_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Readiness Id",
      "type": "string"
    }
  },
  "required": [
    "action_id",
    "case_id",
    "actor_id",
    "readiness_id",
    "readiness_digest",
    "created_at",
    "expires_at"
  ],
  "title": "ActionIntentV1",
  "type": "object"
}
