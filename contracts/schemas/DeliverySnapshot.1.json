{
  "$defs": {
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Evidence Refs",
          "type": "array"
        },
        "input_ref": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Ref"
        },
        "owner_role": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Owner Role",
          "type": "string"
        },
        "recovery": {
          "enum": [
            "retry_read",
            "reconnect",
            "supply_input",
            "review_scope",
            "reapprove",
            "await_counterpart",
            "reconcile",
            "unsupported"
          ],
          "title": "Recovery",
          "type": "string"
        }
      },
      "required": [
        "code",
        "input_ref",
        "owner_role",
        "recovery",
        "evidence_refs"
      ],
      "title": "Issue",
      "type": "object"
    }
  },
  "$id": "https://goldgraft.dev/schemas/DeliverySnapshot.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_plan_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Action Plan Ref"
    },
    "approval_set_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approval Set Ref"
    },
    "cancellation_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cancellation Ref"
    },
    "case_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Case Id",
      "type": "string"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "current_evidence_refs": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Current Evidence Refs",
      "type": "array"
    },
    "deployment_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Deployment Ref"
    },
    "exit_manifest_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exit Manifest Ref"
    },
    "exit_plan_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exit Plan Ref"
    },
    "final_asset_manifest_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Final Asset Manifest Ref"
    },
    "generation": {
      "exclusiveMinimum": 0,
      "title": "Generation",
      "type": "integer"
    },
    "graph_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Graph Ref",
      "type": "string"
    },
    "issue": {
      "anyOf": [
        {
          "$ref": "#/$defs/Issue"
        },
        {
          "type": "null"
        }
      ]
    },
    "lifecycle_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Lifecycle Ref",
      "type": "string"
    },
    "pending_effect_refs": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Pending Effect Refs",
      "type": "array"
    },
    "reservation_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reservation Ref"
    },
    "review_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Review Ref"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Run Id",
      "type": "string"
    },
    "state_cutover_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "State Cutover Ref"
    },
    "state_version": {
      "exclusiveMinimum": 0,
      "title": "State Version",
      "type": "integer"
    }
  },
  "required": [
    "case_id",
    "run_id",
    "generation",
    "state_version",
    "lifecycle_ref",
    "graph_ref",
    "review_ref",
    "action_plan_ref",
    "approval_set_ref",
    "reservation_ref",
    "state_cutover_ref",
    "deployment_ref",
    "final_asset_manifest_ref",
    "exit_plan_ref",
    "exit_manifest_ref",
    "current_evidence_refs",
    "pending_effect_refs",
    "cancellation_ref",
    "issue",
    "checked_at"
  ],
  "title": "DeliverySnapshotV1",
  "type": "object"
}
