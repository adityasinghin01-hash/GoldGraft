{
  "$defs": {
    "DbChange": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "key": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Key",
          "type": "object"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "table",
        "key",
        "before",
        "after"
      ],
      "title": "DbChange",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "SHOP_TO_PAYPAL",
        "PAYPAL_TO_SHOP",
        "BROWSER_TO_SHOP",
        "PAYPAL_NOTIFY_TO_SHOP",
        "SHOP_DB_WRITE"
      ],
      "title": "Direction",
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "RawExchange": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "db_change": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "direction": {
                "const": "SHOP_DB_WRITE"
              }
            }
          },
          "then": {
            "properties": {
              "db_change": {
                "type": "object"
              }
            },
            "required": [
              "db_change"
            ]
          }
        }
      ],
      "oneOf": [
        {
          "not": {
            "required": [
              "body_json"
            ]
          },
          "properties": {
            "body_text": {
              "type": "string"
            }
          },
          "required": [
            "body_text"
          ]
        },
        {
          "not": {
            "required": [
              "body_text"
            ]
          },
          "required": [
            "body_json"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "body_text"
                ]
              },
              {
                "required": [
                  "body_json"
                ]
              }
            ]
          },
          "properties": {
            "direction": {
              "const": "SHOP_DB_WRITE"
            }
          }
        }
      ],
      "properties": {
        "body_json": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "body_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Text"
        },
        "db_change": {
          "anyOf": [
            {
              "$ref": "#/$defs/DbChange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "t_ms": {
          "minimum": 0,
          "title": "T Ms",
          "type": "integer"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "t_ms",
        "direction",
        "method",
        "url",
        "headers"
      ],
      "title": "RawExchange",
      "type": "object"
    },
    "Variant": {
      "enum": [
        "OLD",
        "OLD_TWIN",
        "NEW"
      ],
      "title": "Variant",
      "type": "string"
    }
  },
  "$id": "https://goldgraft.dev/schemas/RawCapture.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "exchanges": {
      "items": {
        "$ref": "#/$defs/RawExchange"
      },
      "title": "Exchanges",
      "type": "array"
    },
    "graft_id": {
      "minLength": 1,
      "title": "Graft Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "variant": {
      "$ref": "#/$defs/Variant"
    }
  },
  "required": [
    "graft_id",
    "run_id",
    "variant",
    "scenario_id",
    "exchanges"
  ],
  "title": "RawCaptureV1",
  "type": "object"
}
