          "maxItems": 256,
          "title": "Check Refs",
          "type": "array"
        },
        "controller_state": {
          "enum": [
            "unbound",
            "waiting",
            "approved",
            "revoked",
            "unknown"
          ],
          "title": "Controller State",
          "type": "string"
        },
        "environment": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Environment",
          "type": "string"
        },
        "label": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "node_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Node Id",
          "type": "string"
        },
        "permitted_actions": {
          "items": {
            "maxLength": 256,
