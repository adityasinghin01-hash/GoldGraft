      "type": "object"
    },
    "ProcessingRecipient": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "purpose": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "region_text": {
          "maxLength": 8192,
          "minLength": 1,
