        "read_scope_text": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Read Scope Text",
          "type": "string"
        },
        "source_snapshot_ref": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
