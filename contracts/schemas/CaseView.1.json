        },
        "retention_text": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Retention Text",
          "type": "string"
        },
        "terms_evidence_refs": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Terms Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "name",
        "purpose",
        "region_text",
        "retention_text",
        "terms_evidence_refs"
