  "$id": "https://goldgraft.dev/schemas/CaseView.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionStatusView"
        },
        {
          "type": "null"
        }
      ]
    },
    "case": {
      "$ref": "#/$defs/ConnectionCase"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "delivery_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Delivery Ref"
    },
    "evidence_class": {
