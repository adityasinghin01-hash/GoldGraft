        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "fixture_profile_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fixture Profile Digest",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "processing_policy_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Processing Policy Digest",
          "type": "string"
        },
        "readiness_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Readiness Digest",
          "type": "string"
        },
        "readiness_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Readiness Id",
          "type": "string"
        },
        "resource_evidence_digests": {
          "maxProperties": 256,
          "patternProperties": {
            "^\\S+$": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 256,
            "minLength": 1
          },
          "title": "Resource Evidence Digests",
          "type": "object"
        },
        "resource_graph_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Resource Graph Digest",
          "type": "string"
        },
        "runtime_profile_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Runtime Profile Digest",
          "type": "string"
        },
        "scope_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Scope Digest",
          "type": "string"
        },
        "source_manifest_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Manifest Digest",
          "type": "string"
        },
        "source_snapshot_refs": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Source Snapshot Refs",
          "type": "array"
        },
        "work_package_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Work Package Digest",
          "type": "string"
        },
        "work_package_ref": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Work Package Ref",
          "type": "string"
        }
      },
      "required": [
        "readiness_id",
        "case_id",
        "actor_id",
        "work_package_ref",
        "work_package_digest",
        "resource_graph_digest",
        "source_snapshot_refs",
        "source_manifest_digest",
        "resource_evidence_digests",
        "binding_epochs",
        "scope_digest",
        "processing_policy_digest",
        "runtime_profile_digest",
        "fixture_profile_digest",
        "checks",
        "issued_at",
        "expires_at",
        "readiness_digest"
      ],
      "title": "ConnectionReadiness",
      "type": "object"
    },
    "LifecycleRun": {
      "additionalProperties": false,
      "properties": {
        "active_effect_refs": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "maxItems": 256,
