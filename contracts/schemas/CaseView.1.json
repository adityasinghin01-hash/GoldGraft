{
  "$defs": {
    "ActionStatusView": {
      "additionalProperties": false,
      "properties": {
        "acceptance_ref": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Acceptance Ref"
        },
        "status": {
          "$ref": "#/$defs/WorkStatus"
        }
      },
      "required": [
        "status",
        "acceptance_ref"
      ],
      "title": "ActionStatusView",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Check Id",
          "type": "string"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Evidence Refs",
          "type": "array"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "recovery_code": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recovery Code"
        },
        "status": {
          "enum": [
            "pass",
            "missing",
            "unsupported",
            "failed",
            "stale",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "status",
        "evidence_refs",
        "checked_at",
        "expires_at",
        "recovery_code"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "ConnectionCase": {
      "additionalProperties": false,
      "properties": {
        "binding_refs": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Binding Refs",
          "type": "array"
        },
        "case_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Case Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "graph_ref": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Graph Ref"
        },
        "requester_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Requester Id",
          "type": "string"
        },
        "shop_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Shop Url",
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "waiting_controller",
            "checking",
            "setup_needed",
            "ready",
            "accepted",
            "closed"
