      "required": [
        "case_id",
        "tenant_id",
        "requester_id",
        "shop_url",
        "created_at",
        "graph_ref",
        "binding_refs",
        "status"
      ],
      "title": "ConnectionCase",
      "type": "object"
    },
    "ConnectionReadiness": {
      "additionalProperties": false,
