{
  "$id": "https://goldgraft.dev/schemas/P5Problem.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Code",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "maxLength": 8192,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Detail"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Evidence Refs",
      "type": "array"
    },
    "instance": {
      "anyOf": [
        {
          "maxLength": 8192,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Instance"
    },
    "reason_code": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Reason Code",
      "type": "string"
    },
    "recovery_action": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Recovery Action"
    },
    "request_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Request Id",
      "type": "string"
    },
    "retry": {
      "enum": [
        "never",
        "status_only",
        "safe_read",
        "reauthorise"
      ],
      "title": "Retry",
      "type": "string"
    },
    "status": {
      "maximum": 599,
      "minimum": 400,
      "title": "Status",
      "type": "integer"
    },
    "title": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "type": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "title",
    "status",
    "detail",
    "instance",
    "code",
    "request_id",
    "reason_code",
    "retry",
    "recovery_action",
    "evidence_refs"
  ],
  "title": "P5ProblemV1",
  "type": "object"
}
